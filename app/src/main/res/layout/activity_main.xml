<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bridge_bg"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FileBridge"
        android:textColor="@color/bridge_accent"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Browser-based file access — no app needed on the other side"
        android:textColor="@color/bridge_muted"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bridge_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server stopped"
                android:textColor="@color/bridge_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/urlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/bridge_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textIsSelectable="true"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/hintLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open this address in a browser on any device on the same Wi-Fi"
                android:textColor="@color/bridge_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/passwordField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Optional password (leave blank for none)"
        android:textColorHint="@color/bridge_muted"
        android:textColor="@color/bridge_text"
        android:inputType="textPassword"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/toggleButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Start Server"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="@color/bridge_accent"
        android:textColor="@color/bridge_bg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tip: keep this screen or the notification running while you use the browser."
        android:textColor="@color/bridge_muted"
        android:textSize="12sp"
        android:layout_marginTop="20dp" />

</LinearLayout>
